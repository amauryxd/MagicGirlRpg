  dialoguesElements:
  - dialogues: "\xBFC\xF3mo un avion llega a este sitio?"
    girlName: 3
    girlImage: {fileID: 4816797671222539444, guid: eac56e624c16802409809974ed6594b0, type: 3}
    typingTime: 0.05
  - dialogues: "\xBFY porqu\xE9 esta tan chiquito?"
    girlName: 3
    girlImage: {fileID: 4816797671222539444, guid: eac56e624c16802409809974ed6594b0, type: 3}
    typingTime: 0.05
  - dialogues: Recuerda que este sitio no es lo mismo que nuestra realidad
    girlName: 1
    girlImage: {fileID: -1013584696244200389, guid: b8b30ddd1e8787d40ab7a3afd58e75bf, type: 3}
    typingTime: 0.05
  - dialogues: Hay cosas que no tienen sentido para nosotras
    girlName: 1
    girlImage: {fileID: -1013584696244200389, guid: b8b30ddd1e8787d40ab7a3afd58e75bf, type: 3}
    typingTime: 0.05
  - dialogues: Yo apoyo a sayo con lo chiquito que esta el avion
    girlName: 2
    girlImage: {fileID: -3721210488497001945, guid: 48986e4002d1e514fb03422babcbf25d, type: 3}
    typingTime: 0.05
  - dialogues: "\xBFY si nos lo llevamos?"
    girlName: 2
    girlImage: {fileID: -4541812918945944788, guid: 05576abdf0daf7d48a2afbef83e467b8, type: 3}
    typingTime: 0.05
  - dialogues: No
