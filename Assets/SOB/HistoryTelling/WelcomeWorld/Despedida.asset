  m_Script: {fileID: 11500000, guid: 6938649de432b284498fb8bd417b6c33, type: 3}
  m_Name: Despedida
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesSOB
  dialoguesElements:
  - dialogues: Otra Vez lo hemos hecho
    anexedText: 0
    typingTime: 0.05
  - dialogues: "hemos matado a una creadora de estos seres hechos de \xE9ter"
    anexedText: 0
    typingTime: 0.05
  - dialogues: "pero cada que las matamos\u2026"
    anexedText: 0
    typingTime: 0.05
  - dialogues: "recuerdo un poco m\xE1s de algo que pas\xF3"
    anexedText: 0
    typingTime: 0.05
  - dialogues: que no se pudo evitar
    anexedText: 0
    typingTime: 0.05
  - dialogues: "visualiz\xF3 parte de la vida de esa persona"
    anexedText: 0
    typingTime: 0.05
  - dialogues: una persona que creo que era importante para mi
    anexedText: 0
    typingTime: 0.05
  - dialogues: "pero no puedo recordar\u2026"
    anexedText: 0
    typingTime: 0.05
  - dialogues: "\xBFQui\xE9n eres?"
    anexedText: 0
    typingTime: 0.05
